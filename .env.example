# Server-side key: used by /api/maps/route to call the Routes API. Never sent to the browser.
# Required APIs: Routes API.
GOOGLE_MAPS_API_KEY=

# Browser key: loads the Maps JavaScript API. Restrict it by HTTP referrer in Google Cloud Console.
# Required APIs: Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud Console (Map Management). Falls back to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
